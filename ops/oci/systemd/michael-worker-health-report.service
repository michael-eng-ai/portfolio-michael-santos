[Unit]
Description=Michael Business worker health report
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/michael-business/worker.env
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
User=michaelworker
Group=michaelworker
WorkingDirectory=/opt/michael-business/portfolio-michael-santos
EnvironmentFile=/etc/michael-business/worker.env
ExecStart=/usr/bin/flock -n /opt/michael-business/run/worker-health-report.lock /usr/bin/env pnpm content:worker:health
Nice=15
TimeoutStartSec=2min
SyslogIdentifier=michael-worker-health-report
Restart=on-failure
RestartSec=2min

[Install]
WantedBy=multi-user.target
