[Unit]
Description=Michael Business daily trend briefing worker
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/michael-business/worker.env

[Service]
Type=oneshot
User=michaelworker
Group=michaelworker
WorkingDirectory=/opt/michael-business/portfolio-michael-santos
EnvironmentFile=/etc/michael-business/worker.env
ExecStart=/usr/bin/flock -n /opt/michael-business/run/daily-briefing.lock /usr/bin/env pnpm content:worker:daily-cycle
Nice=10

[Install]
WantedBy=multi-user.target
